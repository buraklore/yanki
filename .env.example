# =====================================================================
# YANKI — environment
# Copy to .env.local for local development; set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# =====================================================================

# ---- database (required) --------------------------------------------
# Neon:     postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/yanki?sslmode=require
# Supabase: postgres://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# ---- cron auth (required) -------------------------------------------
# Any long random string. Vercel Cron sends it as a bearer token; without it
# the scheduled endpoints refuse to run.
# Generate: openssl rand -base64 32
CRON_SECRET=

# ---- AI providers ---------------------------------------------------
# A platform with no key is skipped silently — it never produces a zero that
# looks like bad visibility. Start with OpenAI + Anthropic and add the rest
# later; no code change is needed.
#
# Model names are configuration on purpose. Providers retire models; when that
# happens set the *_MODEL variable instead of waiting for a release. Settings →
# Integrations → "Test all keys" reports the provider's own error.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

XAI_API_KEY=
XAI_MODEL=grok-4

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- Google AI Overviews --------------------------------------------
# No official API exists for AI Overviews. We read it through a licensed SERP
# provider that carries the compliance burden contractually. This is a separate
# subscription from the model APIs above.
# SerpApi is the default; DataForSEO and Bright Data expose the same shape.
SERP_PROVIDER_URL=https://serpapi.com/search
SERP_PROVIDER_KEY=

# ---- prompt generation ----------------------------------------------
# The starter prompt set is written by a model from your brand, category and
# description. Templates are the fallback and they are generic — "oyun ve
# e-pin nedir" is grammatical Turkish that nobody actually searches for.
# Uses ANTHROPIC_API_KEY, or OPENAI_API_KEY if that is the only one set.
PROMPT_MODEL=claude-haiku-4-5

# ---- extraction judge -----------------------------------------------
# A cheap model adjudicates brand mentions the regex matcher found. It can veto
# and grade a candidate; it can never invent one. Uses ANTHROPIC_API_KEY.
JUDGE_MODEL=claude-haiku-4-5

# ---- email (password reset) -----------------------------------------
# Without this, /api/auth/forgot returns a clear 503 instead of pretending to
# send a message that never arrives. Password *change* while signed in works
# regardless.
RESEND_API_KEY=
MAIL_FROM=YANKI <noreply@sizinalanadiniz.com>
# Used to build the reset link. Set it to your production origin.
APP_URL=https://yanki.vercel.app

# ---- development only -----------------------------------------------
# MOCK_ENGINES=1 exercises the whole pipeline without provider keys.
# NEVER set this in production: it produces synthetic answers. With no keys and
# no flag, a scan reports "no_engine_keys" rather than inventing numbers.
# MOCK_ENGINES=0

# Lets an owner grant themselves a paid plan from the UI. Convenient locally,
# a free upgrade for every customer in production. Leave unset.
# ALLOW_SELF_UPGRADE=1

# ---- optional -------------------------------------------------------
# PG_POOL_MAX=5
# WORKER_BATCH=40
